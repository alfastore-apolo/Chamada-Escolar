{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          { "key": "Content-Type", "value": "application/manifest+json" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "!(*.@(js|css|json|png|jpg|jpeg|gif|svg|ico|webp|webmanifest|woff|woff2|ttf|map))",
        "destination": "/index.html"
      }
    ]
  }
}
